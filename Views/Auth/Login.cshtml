@model SistemaPastelaria.Models.LoginViewModel
@inject IConfiguration Configuration
@{
    var brandName = Configuration["Branding:Name"] ?? "Pastelaria da Casa";
    var brandTagline = Configuration["Branding:Tagline"] ?? "Sabor de casa, feito na hora.";
    ViewData["Title"] = "Acesso da equipe";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#a83b25" />
    <title>Acesso da equipe - @brandName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-card">
        <div class="login-brand">
            <span class="brand-mark" aria-hidden="true">P</span>
            <span class="login-brand-copy"><strong>@brandName</strong><small>@brandTagline</small></span>
        </div>
        <h1>Acesso da equipe</h1>
        <p class="intro">Entre para acompanhar pedidos e cuidar do cardápio.</p>

        @if (ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        @if (Model.Funcionarios.Count == 0)
        {
            <div class="alert alert-warning" role="status">
                Nenhum funcionário ativo foi encontrado. Peça ao responsável pelo sistema para verificar o cadastro da equipe.
            </div>
        }
        else
        {
            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label for="idOperario" class="form-label fw-semibold">Funcionário</label>
                    <select asp-for="IdOperario" id="idOperario" class="form-select" required>
                        <option value="">Selecione seu nome</option>
                        @foreach (var op in Model.Funcionarios)
                        {
                            <option value="@op.IdOperario">@op.Nome (@op.Cargo)</option>
                        }
                    </select>
                    <span asp-validation-for="IdOperario" class="field-validation-error"></span>
                </div>

                <div class="mb-4">
                    <label for="senhaPin" class="form-label fw-semibold">PIN de acesso</label>
                    <input asp-for="SenhaPin" id="senhaPin" type="password" inputmode="numeric" autocomplete="current-password"
                           class="form-control pin-input" maxlength="4" pattern="[0-9]{4}" placeholder="••••" required />
                    <span asp-validation-for="SenhaPin" class="field-validation-error"></span>
                    <div class="form-text">Digite seu PIN de 4 números.</div>
                </div>

                <button type="submit" class="btn btn-pastel btn-lg w-100">Entrar no painel <span aria-hidden="true">→</span></button>
            </form>
        }

        <a class="d-block mt-4 text-center small text-decoration-none text-secondary" asp-controller="Catalog" asp-action="Index">Voltar ao cardápio</a>
        <img class="staff-illustration" src="~/images/pastel.svg" alt="" />
    </main>
</body>
</html>
