@{
    ViewData["Title"] = "Abertura de caixa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Início do turno</span>
        <h1 class="section-title mt-2">Abra o caixa para começar</h1>
        <p class="text-muted">Informe o valor disponível para troco. Depois disso, o operador poderá registrar as comandas.</p>

        <form action="/api/caixa/abrir" method="post" class="mt-4" id="abrir-caixa-form">
            @Html.AntiForgeryToken()
            <label class="form-label fw-semibold" for="valorInicial">Fundo de caixa</label>
            <div class="input-group input-group-lg mb-2">
                <span class="input-group-text">R$</span>
                <input class="form-control" id="valorInicial" name="valorInicial" type="number" min="0" step="0.01" value="0" required />
            </div>
            <button class="btn btn-pastel btn-lg w-100 mt-3" type="submit">Abrir caixa e ir para o PDV</button>
        </form>

        <a class="d-block text-center mt-4 text-secondary text-decoration-none" asp-controller="Home" asp-action="Index">Voltar ao painel</a>
    </div>
</section>

