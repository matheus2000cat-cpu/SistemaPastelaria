@model Produto
@{
    ViewData["Title"] = "Editar produto";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <section class="panel-card p-4 p-md-5">
            <span class="eyebrow">Cardápio</span>
            <h1 class="section-title">Editar produto</h1>
            <form asp-action="AtualizarProduto" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="IdProduto" type="hidden" />
                <div asp-validation-summary="All" class="mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" maxlength="100" required />
                    <span asp-validation-for="Nome"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Categoria" class="form-label">Categoria</label>
                    <input asp-for="Categoria" class="form-control" maxlength="60" required />
                    <span asp-validation-for="Categoria"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for="Preco" class="form-label">Preço (R$)</label>
                    <input asp-for="Preco" class="form-control" type="number" min="0.01" step="0.01" required />
                    <span asp-validation-for="Preco"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ImagemUrl" class="form-label">URL da imagem (opcional)</label>
                    <input asp-for="ImagemUrl" class="form-control" type="url" maxlength="500" />
                    <span asp-validation-for="ImagemUrl"></span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-pastel" type="submit">Salvar alterações</button>
                    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                </div>
            </form>
        </section>
    </div>
</div>
