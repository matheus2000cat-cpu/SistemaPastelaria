@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Painel da equipe";
    var statusOptions = new[] { "Pendente", "Em Preparo", "Pronto", "Concluído", "Cancelado" };
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <span class="eyebrow">Área da equipe</span>
        <h1 class="section-title mb-0">Painel de operação</h1>
        <p class="text-muted mb-0">Olá, @Context.Session.GetString("NomeOperario").</p>
    </div>
    <a class="btn btn-outline-dark" asp-controller="Catalog" asp-action="Index">Ver cardápio público</a>
</div>

@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success" role="status">@mensagem</div>
}

<div class="row g-4">
    <div class="col-lg-4">
        <section class="panel-card p-4">
            <span class="eyebrow">Cardápio</span>
            <h2 class="h4 section-title mt-1">Novo produto</h2>
            <form asp-action="CriarProduto" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="mb-3"></div>
                <div class="mb-3">
                    <label class="form-label" for="Nome">Nome</label>
                    <input id="Nome" name="Nome" class="form-control" maxlength="100" required value="@Model.NovoProduto.Nome" />
                    @Html.ValidationMessage("Nome")
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Categoria">Categoria</label>
                    <input id="Categoria" name="Categoria" class="form-control" maxlength="60" placeholder="Pastéis, bebidas..." required value="@Model.NovoProduto.Categoria" />
                    @Html.ValidationMessage("Categoria")
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Descricao">Descrição</label>
                    <textarea id="Descricao" name="Descricao" class="form-control" rows="2" maxlength="500">@Model.NovoProduto.Descricao</textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="Preco">Preço (R$)</label>
                    <input id="Preco" name="Preco" class="form-control" type="number" min="0.01" step="0.01" required value="@(Model.NovoProduto.Preco > 0 ? Model.NovoProduto.Preco.ToString(System.Globalization.CultureInfo.InvariantCulture) : string.Empty)" />
                    @Html.ValidationMessage("Preco")
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ImagemUrl">URL da imagem (opcional)</label>
                    <input id="ImagemUrl" name="ImagemUrl" class="form-control" type="url" maxlength="500" value="@Model.NovoProduto.ImagemUrl" />
                    @Html.ValidationMessage("ImagemUrl")
                </div>
                <button class="btn btn-pastel w-100" type="submit">Cadastrar produto</button>
            </form>
        </section>
    </div>

    <div class="col-lg-8">
        <section class="panel-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><span class="eyebrow">Estoque do cardápio</span><h2 class="h4 section-title mb-0">Produtos</h2></div>
                <span class="badge text-bg-light">@Model.Produtos.Count itens</span>
            </div>
            @if (Model.Produtos.Count == 0)
            {
                <p class="text-muted mb-0">Nenhum produto cadastrado ainda.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Produto</th><th>Preço</th><th>Status</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var produto in Model.Produtos)
                        {
                            <tr>
                                <td><strong>@produto.Nome</strong><div class="small text-muted">@produto.Categoria</div></td>
                                <td>@produto.Preco.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</td>
                                <td><span class="order-status">@(produto.Ativo ? "No cardápio" : "Pausado")</span></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="Editar" asp-route-id="@produto.IdProduto">Editar</a>
                                    @if (produto.Ativo)
                                    {
                                        <form asp-action="DesativarProduto" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@produto.IdProduto" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Pausar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="AtivarProduto" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@produto.IdProduto" />
                                            <button class="btn btn-sm btn-outline-success" type="submit">Reativar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="panel-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div><span class="eyebrow">Acompanhe e atualize</span><h2 class="h4 section-title mb-0">Pedidos recentes</h2></div>
                <span class="badge text-bg-light">@Model.Pedidos.Count pedidos</span>
            </div>
            @if (Model.Pedidos.Count == 0)
            {
                <p class="text-muted mb-0">Os novos pedidos vão aparecer aqui.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                @foreach (var pedido in Model.Pedidos)
                {
                    <article class="border rounded-3 p-3">
                        <div class="d-flex flex-wrap justify-content-between gap-2">
                            <div>
                                <strong>Pedido #@pedido.IdPedido · @pedido.ClienteNome</strong>
                                <div class="small text-muted">@pedido.ClienteTelefone · @pedido.TipoAtendimento · @pedido.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div>
                                @if (pedido.TipoAtendimento == "Delivery")
                                {
                                    <div class="small">@pedido.EnderecoEntrega</div>
                                }
                            </div>
                            <strong>@pedido.ValorTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"))</strong>
                        </div>
                        <ul class="small text-muted my-2">
                            @foreach (var item in pedido.Itens)
                            {
                                <li>@item.Quantidade × @item.NomeProduto</li>
                            }
                        </ul>
                        <form asp-action="AtualizarStatus" method="post" class="d-flex flex-wrap gap-2 align-items-center">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="pedidoId" value="@pedido.IdPedido" />
                            <label class="small fw-semibold" for="status-@pedido.IdPedido">Status</label>
                            <select class="form-select form-select-sm w-auto" id="status-@pedido.IdPedido" name="status">
                                @foreach (var status in statusOptions)
                                {
                                    <option value="@status" selected="@(pedido.Status == status)">@status</option>
                                }
                            </select>
                            <button class="btn btn-sm btn-outline-dark" type="submit">Salvar</button>
                        </form>
                    </article>
                }
                </div>
            }
        </section>
    </div>
</div>
