@model ErrorViewModel
@{
    ViewData["Title"] = "Algo deu errado";
}

<section class="empty-state">
    <img src="~/images/pastel.svg" alt="" />
    <span class="eyebrow">Ops, vamos tentar de novo</span>
    <h1 class="section-title mt-2">Não foi possível carregar esta página.</h1>
    <p class="text-muted">Tente novamente em alguns instantes. Se o problema continuar, avise a equipe.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código para suporte: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-pastel" asp-controller="Catalog" asp-action="Index">Voltar ao cardápio</a>
</section>
