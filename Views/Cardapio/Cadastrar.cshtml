@{
    ViewData["Title"] = "Cadastrar Produto - Pastelaria";
}

<div class="container mt-5" style="max-width: 500px;">
    <div class="card shadow-sm border-0 p-4 rounded-4">
        <h3 class="fw-bold text-danger mb-3 text-center">➕ Novo Produto</h3>

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">@TempData["Erro"]</div>
        }

        <form asp-action="Cadastrar" method="post">
            <div class="mb-3">
                <label class="form-label fw-semibold">Nome do Produto</label>
                <input type="text" name="nome" class="form-control" placeholder="Ex: Pastel de Queijo" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Categoria / Descrição</label>
                <input type="text" name="categoria" class="form-control" placeholder="Ex: Salgados / Bebidas" required />
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Preço (R$)</label>
                <input type="number" step="0.01" name="preco" class="form-control" placeholder="16.20" required />
                <small class="text-muted" style="font-size: 11px;">Use ponto para separar os centavos (ex: 16.20)</small>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-danger fw-bold py-2">Salvar Produto</button>
                <a href="/Cardapio/Index" class="btn btn-outline-secondary py-2">Voltar ao Cardápio</a>
            </div>
        </form>
    </div>
</div>